# ============ Settings ============
{
    auto_https off

    log {
        output stderr
        format json
        level INFO
    }
}

# ============ Inbound ============
:80 {
    log {
        output stderr
        format json
    }

    handle /logs* {
        reverse_proxy grafana:3000
    }

    handle /database* {
        uri strip_prefix /database
        reverse_proxy db-admin:8080
    }

    handle /api* {
        uri strip_prefix /api
        reverse_proxy gateway:8000
    }
}

# ============ Outbound ============
reverse-proxy:80 {
    handle_path /webhook* {
        reverse_proxy webhook-sink:8080
    }

    handle_path /bank* {
        reverse_proxy bank:8000
    }
}